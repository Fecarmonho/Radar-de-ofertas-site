# Copie este arquivo para .env.local e preencha com os seus valores.
# O .env.local é ignorado pelo git — nunca suba ele pro GitHub.
# Passo a passo de onde tirar cada valor: veja SETUP-FIREBASE.md

# ── Endereço público do site ─────────────────────────────────────────
# Usado no sitemap, na URL canônica e no preview de link (WhatsApp etc).
# Em branco, o site usa o endereço que a Vercel dá. Assim que existir
# domínio próprio, preencha aqui e nas variáveis da Vercel — sem isso o
# Google e o WhatsApp continuam vendo o endereço antigo.
NEXT_PUBLIC_SITE_URL=

# ── Firebase Admin (servidor) ────────────────────────────────────────
# Configurações do projeto → Contas de serviço → Gerar nova chave privada.
# A chave privada dá acesso total ao banco: só aqui e nas variáveis da Vercel.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""

# ── Firebase Web (navegador) ─────────────────────────────────────────
# Configurações do projeto → Geral → Seus apps → app Web.
# Estes valores são públicos por natureza (aparecem no navegador).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Google Analytics 4 (opcional) ────────────────────────────────────
# Sem estes dois, o clique só é registrado nos logs do servidor.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
GA4_API_SECRET=

# ── Atualização automática de preços ─────────────────────────────────
# Senha que a Vercel usa para chamar /api/cron/refresh-prices todo dia
# (veja vercel.json). Invente uma frase aleatória e coloque a mesma nas
# variáveis de ambiente da Vercel. Sem ela, a rotina diária não roda —
# mas o botão "Atualizar preços agora" no painel continua funcionando.
CRON_SECRET=

# ── Shopee (opcional) ────────────────────────────────────────────────
# Só usado como rótulo interno; o link de afiliado de cada produto é
# cadastrado direto no painel /admin.
NEXT_PUBLIC_SHOPEE_AFFILIATE_ID=

# ── IA de texto na área de Anúncios (opcional) ───────────────────────
# Gera gancho/legenda/hashtags/prompts com IA de verdade em vez de
# template. Pegue uma chave grátis em aistudio.google.com (Google AI
# Studio → "Get API key", sem cartão de crédito, tem limite diário de
# uso mas não cobra). Sem essa variável, a área de Anúncios continua
# funcionando normalmente — só usa a sugestão por template.
GEMINI_API_KEY=
